            transform: translateY(-4px);
            box-shadow: 0 15px 30px rgba(0,200,150,0.4);
            background: #00b07c;
        }
        .btn-outline-light {
            background: transparent;
            border: 1.5px solid var(--primary);
            color: var(--primary);
            padding: 14px 32px;
            border-radius: 50px;
            font-weight: 600;
            transition: 0.2s;
            cursor: pointer;
