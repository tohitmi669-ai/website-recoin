    <div class="scanner-container">
        <div id="reader"></div>
        <div class="scan-status" id="scanStatus">Arahkan kamera ke barcode produk RECOIN atau mitra</div>
        <button class="close-scanner" id="closeScannerBtn"><i class="fas fa-times"></i> Tutup Kamera</button>
    </div>
</div>

<script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
<script>
    AOS.init({ duration: 800, once: false, mirror: true });

    // === FUNGSI INSTALL APLIKASI ===
    const APP_URL = "https://fancy-biscochitos-7258f2.netlify.app/";
    function redirectToInstall() {
        window.open(APP_URL, '_blank');
    }
    // Pasang event listener ke semua tombol install
    document.querySelectorAll('#installNavBtn, #installHeroBtn, #installCtaBtn, #installFooterBtn').forEach(btn => {
        if (btn) btn.addEventListener('click', redirectToInstall);
    });

    // Navbar scroll
    window.addEventListener('scroll', () => {
        const navbar = document.getElementById('navbar');
        if (window.scrollY > 50) navbar.classList.add('scrolled');
        else navbar.classList.remove('scrolled');
    });

    function scrollToSection(id) {
        document.getElementById(id).scrollIntoView({ behavior: 'smooth' });
    }

    // Mobile menu
    const hamburger = document.getElementById('hamburger');
    const navLinks = document.getElementById('navLinks');
    if (hamburger) {
        hamburger.addEventListener('click', () => navLinks.classList.toggle('mobile-open'));
    }
    document.querySelectorAll('.nav-links a').forEach(link => {
        link.addEventListener('click', (e) => {
            const id = link.getAttribute('href')?.substring(1);
            if (id && document.getElementById(id)) {
                e.preventDefault();
                document.getElementById(id).scrollIntoView({ behavior: 'smooth' });
                navLinks.classList.remove('mobile-open');
            }
        });
    });

    // Dark mode
    const toggleBtn = document.getElementById('darkmodeToggle');
    if (toggleBtn) {
        toggleBtn.addEventListener('click', () => {
            document.body.classList.toggle('light');
            const icon = toggleBtn.querySelector('i');
            if (document.body.classList.contains('light')) {
                icon.classList.remove('fa-moon');
                icon.classList.add('fa-sun');
                document.body.style.backgroundColor = '#f5f9f8';
            } else {
                icon.classList.remove('fa-sun');
                icon.classList.add('fa-moon');
                document.body.style.backgroundColor = '#0A0F0E';
            }
        });
    }

    // ========================
    // FITUR SCAN BARCODE (HTML5 QR CODE)
    // ========================
    let html5QrCode = null;
    const modal = document.getElementById('scannerModal');
    const openBtns = document.querySelectorAll('#openScannerBtn, #openScannerBtn2');
    const closeBtn = document.getElementById('closeScannerBtn');
    const scanStatus = document.getElementById('scanStatus');

    function onScanSuccess(decodedText, decodedResult) {
        if (html5QrCode) {
            html5QrCode.stop().then(() => {
                modal.style.display = 'none';
            }).catch(err => console.error("Stop error:", err));
        }
        let targetUrl = decodedText.trim();
        if (!targetUrl.startsWith('http://') && !targetUrl.startsWith('https://')) {
            targetUrl = `https://recoin.id/product/${encodeURIComponent(targetUrl)}`;
        }
        window.open(targetUrl, '_blank');
        if (scanStatus) {
            scanStatus.innerText = `✅ Scan berhasil! Membuka: ${targetUrl.substring(0, 50)}...`;
            setTimeout(() => {
                scanStatus.innerText = "Arahkan kamera ke barcode produk RECOIN atau mitra";
            }, 3000);
        }
    }

    function onScanFailure(error) {}

    async function startScanner() {
        if (html5QrCode) {
            try { await html5QrCode.stop(); } catch(e) {}
        }
        html5QrCode = new Html5Qrcode("reader");
        const config = { fps: 10, qrbox: { width: 250, height: 250 } };
        try {
            await html5QrCode.start({ facingMode: "environment" }, config, onScanSuccess, onScanFailure);
            if (scanStatus) scanStatus.innerText = "✅ Kamera aktif. Scan barcode apapun akan membuka link di tab baru.";
        } catch (err) {
            if (scanStatus) scanStatus.innerText = "❌ Gagal mengakses kamera. Pastikan izin kamera diberikan.";
        }
    }

    function closeScanner() {
        if (html5QrCode) {
            html5QrCode.stop().then(() => modal.style.display = 'none').catch(() => modal.style.display = 'none');
        } else { if (modal) modal.style.display = 'none'; }
    }

    if (openBtns.length > 0) {
        openBtns.forEach(btn => {
            btn.addEventListener('click', async () => {
                if (modal) modal.style.display = 'flex';
                await startScanner();
            });
        });
    }
    if (closeBtn) closeBtn.addEventListener('click', closeScanner);
    if (modal) modal.addEventListener('click', (e) => { if (e.target === modal) closeScanner(); });

    // ========================
    // ANIMATED COUNTERS
    // ========================
    const targets = {
        heroBotol: 1175, heroTransaksi: 1361, heroKarbon: 58.75,
        impactBotol: 1175, impactKarbon: 58.75, impactTransaksi: 1361, impactOmset: 739700,
        totalUser: 15, activeUser: 6, merchantCount: 5
    };
    function animateNumber(element, end, isFloat = false, isRupiah = false) {
        let start = 0, duration = 1500, startTime = null;
        const step = (timestamp) => {
            if (!startTime) startTime = timestamp;
            const progress = Math.min((timestamp - startTime) / duration, 1);
            let current = start + (end - start) * progress;
            if (isFloat) current = current.toFixed(2);
            else current = Math.floor(current);
            if (isRupiah) element.innerText = new Intl.NumberFormat('id-ID').format(current);
            else element.innerText = current;
            if (progress < 1) requestAnimationFrame(step);
            else element.innerText = isFloat ? end.toFixed(2) : (isRupiah ? new Intl.NumberFormat('id-ID').format(end) : end);
        };
        requestAnimationFrame(step);
    }
    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting && !entry.target.classList.contains('counted')) {
                entry.target.classList.add('counted');
                const id = entry.target.id;
                if (targets[id] !== undefined) {
                    if (id === 'impactOmset') animateNumber(entry.target, targets[id], false, true);
                    else if (id === 'heroKarbon' || id === 'impactKarbon') animateNumber(entry.target, targets[id], true);
                    else animateNumber(entry.target, targets[id], false);
                }
            }
        });
    }, { threshold: 0.3 });
    const elementsToObserve = ['heroBotol','heroTransaksi','heroKarbon','impactBotol','impactKarbon','impactTransaksi','impactOmset','totalUser','activeUser','merchantCount'];
    elementsToObserve.forEach(id => {
        const el = document.getElementById(id);
        if (el) observer.observe(el);
    });
    window.addEventListener('load', () => {
        elementsToObserve.forEach(id => {
            const el = document.getElementById(id);
            if (el && !el.classList.contains('counted') && el.getBoundingClientRect().top < window.innerHeight + 200) {
                el.classList.add('counted');
                if (targets[id] !== undefined) {
                    if (id === 'impactOmset') animateNumber(el, targets[id], false, true);
                    else if (id === 'heroKarbon' || id === 'impactKarbon') animateNumber(el, targets[id], true);
                    else animateNumber(el, targets[id], false);
                }
            }
        });
    });
</script>
</body>
</html>
